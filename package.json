{
  "name": "local-project-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "本地项目工作台 — 让每个本地项目拥有一个可阅读、可操作、可继续工作的首页",
  "author": "miasakii",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack:dir": "electron-vite build && node scripts/prepare-electron-dist.cjs && electron-builder --dir",
    "pack:win": "electron-vite build && node scripts/prepare-electron-dist.cjs && electron-builder --win",
    "measure:pack": "node scripts/measure-pack-size.cjs",
    "verify:packaged": "node scripts/verify-packaged.cjs",
    "verify:release": "npm run pack:dir && npm run measure:pack && npm run verify:packaged",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "check": "biome check",
    "verify:m0-4": "node --experimental-transform-types --import ./scripts/ts-loader/register.mjs scripts/verify-markdown-isolation-m0.mts",
    "verify:m0-5": "node --experimental-transform-types --import ./scripts/ts-loader/register.mjs scripts/verify-file-ops-m0.mts",
    "verify:m0-5:trash": "node scripts/verify-trash-real-m0.cjs",
    "verify:m0-6": "node --experimental-transform-types scripts/verify-git-parse-m0.mts && node --experimental-transform-types scripts/verify-git-repo-m0.mts",
    "verify:m1": "node --experimental-transform-types --import ./scripts/ts-loader/register.mjs scripts/verify-m1.mts",
    "smoke:m1": "node scripts/smoke-m1.cjs",
    "measure:m0-7": "node scripts/measure-framework-m0.cjs 5 --sizes",
    "verify:m0": "npm run verify:m0-4 && npm run verify:m0-5 && npm run verify:m0-5:trash && npm run verify:m0-6",
    "verify:all": "npm run lint && npm run typecheck && npm run build && npm run verify:m0 && npm run verify:m1 && npm run verify:m2 && npm run verify:m3-1 && npm run verify:m3-file-ops && npm run verify:m3-lifecycle && npm run smoke:m1",
    "verify:m2-diff": "node --experimental-transform-types --import ./scripts/ts-loader/register.mjs scripts/verify-m2-diff.mts",
    "verify:m2-degrade": "node --experimental-transform-types --import ./scripts/ts-loader/register.mjs scripts/verify-m2-degrade.mts",
    "verify:m2": "npm run verify:m2-diff && npm run verify:m2-degrade",
    "verify:m3-1": "node --experimental-transform-types --import ./scripts/ts-loader/register.mjs scripts/verify-m3-rename.mts",
    "verify:m3-file-ops": "node --experimental-transform-types --import ./scripts/ts-loader/register.mjs scripts/verify-m3-file-ops.mts",
    "verify:m3-lifecycle": "node --experimental-transform-types --import ./scripts/ts-loader/register.mjs scripts/verify-m3-lifecycle.mts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  }
}
